# Porta HTTP da Lugia
PORT=8787
# URL do nord-tool-backend (a Lugia valida o login chamando /auth/me)
NORD_TOOL_API_URL=http://localhost:8080
# Mesmo PostgreSQL do NordTool (tabelas lugia_* criadas pelo nord-tool-scripts-sql)
LUGIA_DATABASE_URL=postgres://usuario:senha@localhost:5432/nord_tool
# Origens do frontend liberadas no CORS, separadas por vírgula
LUGIA_CORS_ORIGINS=http://localhost:5173

# Chaves dos provedores: só ficam disponíveis os que tiverem chave E modelo configurados
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Modelos exibidos no seletor (separados por vírgula)
LUGIA_MODELOS_CLAUDE=claude-opus-5-5,claude-sonnet-5-5
# Sem padrão: preencha com os IDs que sua chave da OpenAI acessa
LUGIA_MODELOS_OPENAI=
LUGIA_MODELOS_GEMINI=gemini-flash-latest

# Tamanho máximo de cada anexo (MB)
LUGIA_ANEXO_MAX_MB=10
